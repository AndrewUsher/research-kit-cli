{
	"name": "@andrewusher/research-kit-cli",
	"version": "0.0.0",
	"license": "MIT",
	"bin": {
		"research-kit-cli": "dist/cli.js"
	},
	"type": "module",
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"build": "tsc",
		"dev": "tsc --watch",
		"test": "prettier --check . && xo && ava"
	},
	"files": [
		"dist"
	],
	"dependencies": {
		"@ai-sdk/amazon-bedrock": "^4.0.59",
		"ai": "^6.0.85",
		"cheerio": "^1.2.0",
		"exa-js": "^2.3.0",
		"ink": "^4.1.0",
		"js-yaml": "^4.1.1",
		"meow": "^11.0.0",
		"pdf-parse": "^2.4.5",
		"puppeteer": "^24.37.2",
		"react": "^18.2.0",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@sindresorhus/tsconfig": "^3.0.1",
		"@types/js-yaml": "^4.0.9",
		"@types/pdf-parse": "^1.1.5",
		"@types/react": "^18.0.32",
		"@vdemedes/prettier-config": "^2.0.1",
		"ava": "^5.3.1",
		"chalk": "^5.2.0",
		"eslint-config-xo-react": "^0.27.0",
		"eslint-plugin-react": "^7.32.2",
		"eslint-plugin-react-hooks": "^4.6.0",
		"ink-testing-library": "^3.0.0",
		"prettier": "^2.8.7",
		"ts-node": "^10.9.1",
		"typescript": "^5.0.3",
		"xo": "^0.53.1"
	},
	"ava": {
		"extensions": {
			"ts": "module",
			"tsx": "module"
		},
		"nodeArguments": [
			"--loader=ts-node/esm"
		]
	},
	"xo": {
		"extends": "xo-react",
		"prettier": true,
		"rules": {
			"react/prop-types": "off"
		}
	},
	"prettier": "@vdemedes/prettier-config",
	"description": "Intelligent Research Assistant CLI - An autonomous CLI tool for conducting comprehensive research",
	"keywords": [
		"cli",
		"research",
		"ink",
		"react",
		"terminal"
	],
	"author": "Andrew Usher"
}
